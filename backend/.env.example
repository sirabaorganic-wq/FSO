# ══════════════════════════════════════════════════════════
#  FSO MARKETPLACE BACKEND — Environment Configuration
#  Flash Sales Online — Heritage Kitchen Marketplace
#
#  IMPORTANT:
#  - Copy this file to .env and fill in your values
#  - NEVER commit .env to version control
#  - NEVER share real secrets in this file
#  - All values below are placeholders only
# ══════════════════════════════════════════════════════════

# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database (Neon PostgreSQL) ───────────────────────────
# FSO authoritative persistent database is Neon PostgreSQL via Prisma ORM.
# NEVER connect FSO to Siraba MongoDB.
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"

# Redis (used by BullMQ job queues and Shiprocket token cache)
REDIS_URL=redis://localhost:6379

# ─── JWT Authentication ───────────────────────────────────
# REQUIRED: Must be a strong random secret. Never use 'secret123' or similar.
# Generate with: node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_SECRET=

# REQUIRED: Separate secret for refresh tokens. Must be a strong random secret. No fallback is permitted.
# Generate with: node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_REFRESH_SECRET=

# Token expiry durations (e.g. 15m, 7d, 1h)
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── CORS ─────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
# Example: CORS_ORIGINS=https://flashsalesonline.in,https://www.flashsalesonline.in
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=

# ─── FSO Brand Configuration ──────────────────────────────
FSO_BRAND_NAME=Flash Sales Online
FSO_BRAND_SHORT=FSO
FSO_WEBSITE_URL=https://flashsalesonline.in
FSO_ADMIN_EMAIL=admin@flashsalesonline.in
FSO_SUPPORT_EMAIL=support@flashsalesonline.in

# ─── Razorpay Payment Gateway ─────────────────────────────
# Use Razorpay TEST keys for development — never use production keys in dev
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Required for webhook signature verification — MUST be set in production
RAZORPAY_WEBHOOK_SECRET=

# ─── Shiprocket Logistics ─────────────────────────────────
SHIPROCKET_API_EMAIL=
SHIPROCKET_API_PASSWORD=
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_WEBHOOK_SECRET=

# ─── Cloudinary Media Storage ─────────────────────────────
# Use a dedicated FSO Cloudinary account or folder prefix
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Cloudflare R2 Storage (Optional) ────────────────────
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# ─── Email Service (Nodemailer / SMTP) ───────────────────
# Use a test/development SMTP account — never use production SMTP in dev
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=FSO Marketplace <noreply@flashsalesonline.in>
EMAIL_SERVICE=gmail

# ─── SMS Service (Twilio) ─────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── Platform Contact ─────────────────────────────────────
PLATFORM_PHONE=
PLATFORM_EMAIL=support@flashsalesonline.in

# ─── Optional: Imagekit CDN ───────────────────────────────
# Not used in Phase 11 — reserved for future
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# ─── Firebase (Optional Push Notifications) ───────────────
# Not required in Phase 11
FIREBASE_SERVICE_ACCOUNT=
